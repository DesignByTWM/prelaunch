# DESIGNBYTWM · environment variables
# Copy to .env.local for local development.
# In Vercel, set under Project Settings, Environment Variables.

# -----------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL
# -----------------------------------------------------------------
# Optional. Leave it UNSET for review deployments.
#
# When unset, the app resolves its own origin automatically:
#   1. NEXT_PUBLIC_VERCEL_URL, which Vercel injects on every deployment
#   2. http://localhost:3000 for local development
#
# There is no fallback to the production domain. That is deliberate.
#
# The indexing gate in lib/site.ts is a strict equality check against
# https://designbytwm.com. Anything else, including every .vercel.app URL,
# is served noindex with robots.txt disallowing everything.
#
# So during client review you set NOTHING here and the build is
# automatically hidden from search with correct canonical URLs pointing at
# the Vercel address rather than at the live domain.
#
# ONLY set this at launch, and only to the exact production origin:
# NEXT_PUBLIC_SITE_URL=https://designbytwm.com


# -----------------------------------------------------------------
# LEAD PIPELINE · not yet implemented
# -----------------------------------------------------------------
# Forms are inactive during the client review build. These are the keys
# the pipeline will need once field structure is confirmed.

# Resend, transactional email delivery
# RESEND_API_KEY=
# LEAD_NOTIFY_TO=info@designbytwm.com,designbytwmwebmaster@gmail.com,media@designbytwm.com
# LEAD_FROM_ADDRESS=

# Airtable, lead capture records
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_TABLE_NAME=


# -----------------------------------------------------------------
# ANALYTICS · not yet implemented
# -----------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=
